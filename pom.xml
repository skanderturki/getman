<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.getman</groupId>
  <artifactId>getman-parent</artifactId>
  <version>0.9.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>GetMan</name>

  <properties>
    <tycho.version>4.0.13</tycho.version>
    <!-- Oldest Eclipse release we compile against. Plugins built here also install on newer releases. -->
    <eclipse.release.url>https://download.eclipse.org/releases/2024-03/</eclipse.release.url>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>bundles/com.getman.core</module>
    <module>bundles/com.getman.ui</module>
    <module>bundles/com.getman.doc</module>
    <module>bundles/com.getman.mcp</module>
    <module>tests/com.getman.core.tests</module>
    <module>tests/com.getman.mcp.tests</module>
    <module>features/com.getman.feature</module>
    <module>features/com.getman.mcp.feature</module>
    <module>releng/com.getman.site</module>
  </modules>

  <repositories>
    <repository>
      <id>eclipse-release</id>
      <layout>p2</layout>
      <url>${eclipse.release.url}</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <!-- Resolve against the BREE (a known profile) rather than the build JDK; otherwise Tycho
               publishes a synthetic a.jre.javase unit for the build JDK into the update site. -->
          <executionEnvironment>JavaSE-17</executionEnvironment>
          <environments>
            <environment><os>win32</os><ws>win32</ws><arch>x86_64</arch></environment>
            <environment><os>linux</os><ws>gtk</ws><arch>x86_64</arch></environment>
            <environment><os>macosx</os><ws>cocoa</ws><arch>x86_64</arch></environment>
            <environment><os>macosx</os><ws>cocoa</ws><arch>aarch64</arch></environment>
          </environments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-packaging-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <format>yyyyMMddHHmm</format>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
